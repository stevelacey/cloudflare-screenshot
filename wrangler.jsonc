{
  "name": "screenshot",
  "main": "src/index.js",
  "browser": {
    "binding": "MYBROWSER"
  },
  "compatibility_date": "2026-03-17",
  // @cloudflare/puppeteer reads browser messages as ArrayBuffers, which newer dates turn into Blobs
  "compatibility_flags": ["nodejs_compat", "no_websocket_standard_binary_type"],
  "durable_objects": {
    "bindings": [
      {
        "name": "BROWSER",
        "class_name": "Browser"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Browser"]
    }
  ],
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.browser.js"],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "screenshots"
    }
  ]
}
