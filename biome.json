{
  "files": {
    "includes": ["**", "!src/gifenc.browser.js", "!src/h264.browser.js"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useNodejsImportProtocol": "off"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
